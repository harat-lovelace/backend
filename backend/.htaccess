# ==============================================================
# LAUNDRY MANAGEMENT SYSTEM API - .HTACCESS
# ==============================================================
# This file handles URL rewriting and security for the backend API
# 
# Requirements:
# - Apache web server with mod_rewrite enabled
# - .htaccess files must be allowed (AllowOverride All)
# ==============================================================

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Set the base path for rewrites
    RewriteBase /jenjen-po-main/backend/
    
    # Remove public from browser but keep out of the URL structure
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite all requests to index.php
    RewriteRule ^(.*)$ index.php?$1 [QSA,L]
</IfModule>

# ==============================================================
# SECURITY HEADERS
# ==============================================================

# Add security headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==============================================================
# COMPRESSION
# ==============================================================

# Enable gzip compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ==============================================================
# CACHE CONTROL
# ==============================================================

# Set cache headers for different file types
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    
    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # JSON (usually don't cache)
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ==============================================================
# DIRECTORY PROTECTION
# ==============================================================

# Prevent directory listing
Options -Indexes

# Deny access to sensitive files
<FilesMatch "\.env|database\.php|constants\.php|\.sql|\.log">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow access to index.php
<Files index.php>
    Order Allow,Deny
    Allow from all
</Files>

# ==============================================================
# PERFORMANCE OPTIMIZATION
# ==============================================================

# Disable ETags for better performance
Header unset ETag
FileETag None

# Set proper MIME types
AddType application/json .json
AddType application/javascript .js
AddType text/css .css
